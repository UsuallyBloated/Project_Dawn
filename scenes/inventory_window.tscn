[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/inventory_window.gd" id="1_inventory"]

[node name="InventoryWindow" type="Panel"]
theme_type_variation = &"WindowPanel"
script = ExtResource("1_inventory")

[node name="VBox" type="VBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 8.0
offset_top = 8.0
offset_right = -8.0
offset_bottom = -8.0
theme_override_constants/separation = 4

[node name="Header" type="HBoxContainer" parent="VBox"]

[node name="Title" type="Label" parent="VBox/Header"]
size_flags_horizontal = 3
theme_type_variation = &"TitleLabel"
theme_override_font_sizes/font_size = 14
text = "Inventory"

[node name="StackBtn" type="Button" parent="VBox/Header"]
tooltip_text = "Consolidate stackable items into fewest stacks"
theme_override_font_sizes/font_size = 10
text = "Stack All"
flat = true

[node name="CloseBtn" type="Button" parent="VBox/Header"]
text = "✕"
flat = true

[node name="Grid" type="GridContainer" parent="VBox"]
theme_override_constants/h_separation = 4
theme_override_constants/v_separation = 4
columns = 2

[node name="WalletLabel" type="Label" parent="VBox"]
tooltip_text = "Your coins, as carried — stacks are never consolidated automatically. Every coin has weight."
mouse_filter = 1
theme_type_variation = &"CoinsLabel"
theme_override_font_sizes/font_size = 12
horizontal_alignment = 1

[node name="BottomRow" type="HBoxContainer" parent="VBox"]
theme_override_constants/separation = 8
alignment = 1
