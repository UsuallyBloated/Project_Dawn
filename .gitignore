# Godot 4+ specific ignores
.godot/
/android/

# Local secrets — never commit
HTML_LOW_POLY_TOOL/.env
HTML_LOW_POLY_TOOL/reference_images/

# Built executables — distributed out-of-band, not via git
builds/

# Runtime debug log — rotated by autoloads/debug_log.gd
debug.log
debug_prev.log

# Captured server output from playtests (`cargo run ... | Tee-Object server.log`) and the
# per-playtest server logs parked next to their checklists. Evidence for triage while a
# session is live, not project history — no .log has ever been tracked here.
server.log
docs/playtest_notes/*.log

# GDExtension build artifacts — rebuilt from F:/Projects/server/crates/gdext-net/
# via addons/gdext_net/build.ps1. Never commit binary blobs.
addons/gdext_net/*.dll
addons/gdext_net/*.so
addons/gdext_net/*.dylib
addons/gdext_net/*.pdb

# kodr-skills: an outside skill library (F:\Projects\kodr-skills), junctioned
# into .claude/skills. Ignored by family prefix so a skill of our own still commits.
.claude/skills/ai-*/
.claude/skills/blockchain-*/
.claude/skills/cs-*/
.claude/skills/dist-*/
.claude/skills/rust-*/
.claude/skills/devops-github-workflows/
.claude/skills/security-software/
.claude/skills/typesafe-ai/
