extends SceneTree
# Renders every UI palette in data/ui_theme_palettes.gd into a Theme resource,
# assets/ui/themes/<id>.tres, through ONE template, so the ten themes share
# their structure and their structural numbers (border widths, content
# margins: the geometry fixture holds for all of them) and differ in colour,
# corner radius and shadow alone. tools/check_ui_theme_lockstep.gd renders the
# same text and fails when a file on disk is stale. Run after any palette or
# template change:
#   godot --headless --path . -s tools/author_ui_themes.gd
# then `--import` once so the editor's cache sees the files.

const OUT_DIR := "res://assets/ui/themes"

func _initialize() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT_DIR))
	var written := 0
	for id in UIThemePalettes.ORDER:
		var path := UIThemePalettes.theme_path(id)
		var f := FileAccess.open(path, FileAccess.WRITE)
		if f == null:
			printerr("cannot write " + path)
			quit(1)
			return
		f.store_string(render(id))
		f.close()
		written += 1
		print("wrote " + path)
	print("%d themes written" % written)
	quit(0)

static func _c(c: Color) -> String:
	return "Color(%s, %s, %s, %s)" % [_f(c.r), _f(c.g), _f(c.b), _f(c.a)]

static func _f(v: float) -> String:
	# Godot's own text form: no trailing zeros, "1" for one.
	var s := "%.4f" % v
	s = s.rstrip("0")
	if s.ends_with("."):
		s = s.substr(0, s.length() - 1)
	return s

static func _box(id: String, bg: Color, border: Color, border_w: int, radius: int, margins: Array = [], extra: String = "") -> String:
	var out := '[sub_resource type="StyleBoxFlat" id="%s"]\n' % id
	if margins.size() == 4:
		out += "content_margin_left = %.1f\ncontent_margin_top = %.1f\ncontent_margin_right = %.1f\ncontent_margin_bottom = %.1f\n" % [margins[0], margins[1], margins[2], margins[3]]
	out += "bg_color = %s\n" % _c(bg)
	if border_w > 0:
		out += "border_width_left = %d\nborder_width_top = %d\nborder_width_right = %d\nborder_width_bottom = %d\n" % [border_w, border_w, border_w, border_w]
		out += "border_color = %s\n" % _c(border)
	if radius > 0:
		out += "corner_radius_top_left = %d\ncorner_radius_top_right = %d\ncorner_radius_bottom_right = %d\ncorner_radius_bottom_left = %d\n" % [radius, radius, radius, radius]
	out += extra
	return out + "\n"

# A tab: rounded on top only, a border on three sides.
static func _tab(id: String, bg: Color, border: Color, top_w: int, radius: int) -> String:
	var out := '[sub_resource type="StyleBoxFlat" id="%s"]\n' % id
	out += "content_margin_left = 10.0\ncontent_margin_top = 4.0\ncontent_margin_right = 10.0\ncontent_margin_bottom = 4.0\n"
	out += "bg_color = %s\n" % _c(bg)
	out += "border_width_left = 1\nborder_width_top = %d\nborder_width_right = 1\n" % top_w
	out += "border_color = %s\n" % _c(border)
	if radius > 0:
		out += "corner_radius_top_left = %d\ncorner_radius_top_right = %d\n" % [radius, radius]
	return out + "\n"

static func render(id: String) -> String:
	var p := UIThemePalettes.get_palette(id)
	var d := UIThemePalettes.theme_colors(id)
	var radius: int = p["radius"]
	var shadow: int = p["shadow"]
	var small_r := mini(radius, 2)
	var out := '[gd_resource type="Theme" load_steps=18 format=3]\n\n'
	out += '; %s: a Project Dawn UI theme. GENERATED by tools/author_ui_themes.gd from\n' % p["display"]
	out += '; data/ui_theme_palettes.gd (palette "%s"); edit the palette, not this file.\n' % id
	out += '; Every theme shares this template, so their structural numbers agree and one\n'
	out += '; geometry fixture holds for all; colours, corner radii and shadows differ.\n\n'
	var shadow_extra := ""
	if shadow > 0:
		shadow_extra = "shadow_color = Color(0, 0, 0, 0.45)\nshadow_size = %d\n" % shadow
	out += _box("window", p["window_bg"], p["window_border"], 2, radius, [], shadow_extra)
	out += _box("section", p["section_bg"], p["section_border"], 1, radius)
	out += _box("slot", p["slot_bg"], p["slot_border"], 1, small_r)
	out += _box("tooltip", p["tooltip_bg"], p["slot_border"], 1, radius, [8.0, 6.0, 8.0, 6.0])
	out += _box("button_normal", p["btn_normal"], p["btn_border"], 1, radius, [4.0, 4.0, 4.0, 4.0])
	out += _box("button_hover", p["btn_hover"], p["btn_border_lit"], 1, radius, [4.0, 4.0, 4.0, 4.0])
	out += _box("button_pressed", p["btn_pressed"], p["btn_border_lit"], 1, radius, [4.0, 4.0, 4.0, 4.0])
	out += _box("button_disabled", d["btn_disabled"], d["btn_border_disabled"], 1, radius, [4.0, 4.0, 4.0, 4.0])
	out += '[sub_resource type="StyleBoxFlat" id="focus_ring"]\ndraw_center = false\nborder_width_left = 1\nborder_width_top = 1\nborder_width_right = 1\nborder_width_bottom = 1\nborder_color = %s\n' % _c(d["focus"])
	if radius > 0:
		out += "corner_radius_top_left = %d\ncorner_radius_top_right = %d\ncorner_radius_bottom_right = %d\ncorner_radius_bottom_left = %d\n" % [radius, radius, radius, radius]
	out += "\n"
	out += _box("field", p["slot_bg"], p["slot_border"], 1, small_r, [4.0, 4.0, 4.0, 4.0])
	out += _box("speech", d["speech_bg"], Color.BLACK, 0, 4, [10.0, 8.0, 10.0, 8.0])
	out += _box("bar_strip", d["strip_bg"], p["slot_border"], 1, 4)
	out += _tab("tab_selected", d["tab_selected_bg"], p["window_border"], 2, radius)
	out += _tab("tab_unselected", d["tab_unselected_bg"], p["slot_border"], 1, radius)
	out += _tab("tab_hovered", d["tab_hover_bg"], p["window_border"], 1, radius)
	out += '[sub_resource type="StyleBoxFlat" id="tab_panel"]\ncontent_margin_left = 0.0\ncontent_margin_top = 0.0\ncontent_margin_right = 0.0\ncontent_margin_bottom = 0.0\ndraw_center = false\nborder_width_top = 1\nborder_color = %s\n\n' % _c(p["slot_border"])
	out += '[sub_resource type="StyleBoxEmpty" id="plain"]\ncontent_margin_left = 4.0\ncontent_margin_top = 4.0\ncontent_margin_right = 4.0\ncontent_margin_bottom = 4.0\n\n'
	var text := _c(p["text"])
	var title := _c(p["title"])
	var btn_text := _c(p["btn_text"])
	var btn_hover_text := _c(p["btn_text_hover"])
	out += "[resource]\n"
	out += 'BarStrip/base_type = &"Panel"\nBarStrip/styles/panel = SubResource("bar_strip")\n'
	out += "Button/colors/font_color = %s\n" % btn_text
	out += "Button/colors/font_disabled_color = %s\n" % _c(d["btn_text_disabled"])
	out += "Button/colors/font_focus_color = %s\n" % btn_text
	out += "Button/colors/font_hover_color = %s\n" % btn_hover_text
	out += "Button/colors/font_hover_pressed_color = %s\n" % btn_hover_text
	out += "Button/colors/font_pressed_color = %s\n" % btn_hover_text
	out += 'Button/styles/disabled = SubResource("button_disabled")\nButton/styles/focus = SubResource("focus_ring")\nButton/styles/hover = SubResource("button_hover")\nButton/styles/normal = SubResource("button_normal")\nButton/styles/pressed = SubResource("button_pressed")\n'
	out += "CheckBox/colors/font_color = %s\n" % text
	out += 'CheckBox/styles/disabled = SubResource("plain")\nCheckBox/styles/hover = SubResource("plain")\nCheckBox/styles/normal = SubResource("plain")\nCheckBox/styles/pressed = SubResource("plain")\n'
	out += "CheckButton/colors/font_color = %s\n" % text
	out += 'CheckButton/styles/disabled = SubResource("plain")\nCheckButton/styles/hover = SubResource("plain")\nCheckButton/styles/normal = SubResource("plain")\nCheckButton/styles/pressed = SubResource("plain")\n'
	out += 'CoinsLabel/base_type = &"Label"\nCoinsLabel/colors/font_color = %s\n' % _c(p["coins"])
	out += "ItemList/colors/font_color = %s\n" % text
	out += "Label/colors/font_color = %s\n" % text
	out += "LineEdit/colors/font_color = %s\n" % text
	out += "LineEdit/colors/font_placeholder_color = %s\n" % _c(d["placeholder"])
	out += 'LineEdit/styles/focus = SubResource("focus_ring")\nLineEdit/styles/normal = SubResource("field")\n'
	# A plain Panel with no variation (the login screen's frame, a frame nobody
	# styled) is a raised section, never the engine's grey.
	out += 'Panel/styles/panel = SubResource("section")\n'
	out += 'SectionPanel/base_type = &"Panel"\nSectionPanel/styles/panel = SubResource("section")\n'
	out += 'SlotCell/base_type = &"Panel"\nSlotCell/styles/panel = SubResource("slot")\n'
	out += 'SpeechPanel/base_type = &"PanelContainer"\nSpeechPanel/styles/panel = SubResource("speech")\n'
	out += "TabBar/colors/font_hovered_color = %s\nTabBar/colors/font_selected_color = %s\nTabBar/colors/font_unselected_color = %s\n" % [title, title, text]
	out += 'TabBar/styles/tab_hovered = SubResource("tab_hovered")\nTabBar/styles/tab_selected = SubResource("tab_selected")\nTabBar/styles/tab_unselected = SubResource("tab_unselected")\n'
	out += "TabContainer/colors/font_hovered_color = %s\nTabContainer/colors/font_selected_color = %s\nTabContainer/colors/font_unselected_color = %s\n" % [title, title, text]
	out += 'TabContainer/styles/panel = SubResource("tab_panel")\nTabContainer/styles/tab_hovered = SubResource("tab_hovered")\nTabContainer/styles/tab_selected = SubResource("tab_selected")\nTabContainer/styles/tab_unselected = SubResource("tab_unselected")\nTabContainer/styles/tabbar_background = SubResource("plain")\n'
	out += 'TitleLabel/base_type = &"Label"\nTitleLabel/colors/font_color = %s\n' % title
	out += 'Tooltip/base_type = &"PanelContainer"\nTooltip/styles/panel = SubResource("tooltip")\n'
	out += 'WindowPanel/base_type = &"Panel"\nWindowPanel/styles/panel = SubResource("window")\n'
	return out
