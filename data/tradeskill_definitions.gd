class_name TradeskillDefinitions

# Single source of truth for all tradeskill metadata.
# To add a new skill: append one entry block in the correct section below,
# then add its recipes in data/recipe_definitions.gd.
#
# Entry fields:
#   name               — display name; must match the key used in recipe_definitions.gd
#   desc               — shown in crafting UI
#   category           — "gathering" | "production" | "service"
#   feeds_into         — informational: which skills this one enables
#   requires           — prerequisite skills (informational; not hard-enforced yet)
#   racial_bonus_races — these races earn XP 1.5× faster and get racial_cap_bonus extra cap
#   racial_cap_bonus   — extra cap added on top of base_cap for bonus races
#   exclusive_races    — [] = any race allowed; non-empty = ONLY these races can ever access
#   open_races         — races that always have access regardless of class or alignment
#   allowed_classes    — [] = any class; non-empty = class gate (skipped for open_races)
#   required_alignment — "" = any | "Good" | "NotGood" | "Evil" (skipped for open_races)
#   base_cap           — maximum skill level for non-bonus races

